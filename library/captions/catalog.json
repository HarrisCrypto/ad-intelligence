{
  "id": "library-captions",
  "version": "1.0.0",
  "purpose": "Caption/type presets with safe-zone math — executable for layout + QA",
  "safe_zones": {
    "meta_reels_9x16": {
      "top_clear_pct": 14,
      "bottom_clear_pct": 20,
      "side_clear_pct": 6,
      "note": "Keep critical type inside; CTA above bottom chrome"
    },
    "tiktok_9x16": {
      "top_clear_pct": 12,
      "bottom_clear_pct": 22,
      "side_clear_pct": 6
    }
  },
  "items": [
    {
      "id": "cap_hook_anton",
      "role": "hook",
      "family": "Anton",
      "weight": 400,
      "max_words": 7,
      "max_lines": 2,
      "fill": "#FFFFFF",
      "plate": "soft dark 40% or knockout",
      "safe_zone": "meta_reels_9x16",
      "font_files": "library/typography/fonts/anton/",
      "rule": "Headline ≠ caption string (fm_duplicate_text)"
    },
    {
      "id": "cap_burn_inter_tight",
      "role": "caption",
      "family": "Inter Tight",
      "weight": 600,
      "max_lines": 2,
      "fill": "#FFFFFF",
      "safe_zone": "meta_reels_9x16",
      "font_files": "library/typography/fonts/inter-tight/",
      "rule": "Adds mechanism; must differ from hook"
    },
    {
      "id": "cap_cta_poppins",
      "role": "cta",
      "family": "Poppins",
      "weight": 700,
      "max_lines": 1,
      "fill": "#FFFFFF",
      "treatment": "bold end line OR pill — pick one",
      "safe_zone": "meta_reels_9x16",
      "font_files": "library/typography/fonts/poppins/",
      "min_hold_s": 3,
      "jargon_ban": ["access call", "unlock AI", "get started with AI"]
    },
    {
      "id": "cap_legal_footer",
      "role": "legal",
      "family": "Inter Tight",
      "weight": 400,
      "window_s": [1.5, 2.0],
      "window_note": "last 1.5–2s or omit",
      "safe_zone": "meta_reels_9x16"
    }
  ]
}
