{
  "niche": "home-services",
  "version": "1.1.0",
  "updated": "2026-10-11",
  "rule": "Every bucket needs real moving clips. Stills never fill a footage slot. Eligible = kind:video + reject:false + motion_confirmed:true + niche_fit high|med. Prefer seed_clips (verified Mixkit ids) then search.",
  "keep_per_bucket": { "min": 3, "max": 5 },
  "harvest_candidates_per_bucket": 16,
  "buckets": [
    {
      "id": "hook_vehicle",
      "priority": "P0",
      "must_depict": [
        "work van or trade/freight truck",
        "on a real road or lot",
        "not a diagram",
        "not a beach camper / romance van"
      ],
      "subject": "trade_vehicle",
      "shot_type": ["exterior", "establishing"],
      "seed_clips": [
        { "source": "mixkit", "id": "28787", "title": "cargo truck driving on the highway" },
        { "source": "mixkit", "id": "44621", "title": "white van crossing a desert aerial" },
        { "source": "mixkit", "id": "23011", "title": "freight truck arriving at the warehouse" },
        { "source": "mixkit", "id": "45488", "title": "large truck driving along a rural highway" },
        { "source": "mixkit", "id": "23174", "title": "worker leading a freight truck in the parking" }
      ],
      "queries": {
        "coverr": ["cargo van", "delivery van", "work truck"],
        "mixkit": ["truck", "van"],
        "wikimedia_video": ["cargo truck"],
        "pexels": ["cargo van street", "freight truck warehouse"]
      },
      "reject_hints": ["diagram", "camper", "surf", "couple kiss", "sedan"]
    },
    {
      "id": "hook_phone_ring",
