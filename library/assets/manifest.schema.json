{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HarrisCrypto/ad-intelligence/library/assets/manifest.schema.json",
  "title": "AssetLedgerEntry",
  "type": "object",
  "required": ["id", "path", "kind", "license", "attribution", "source_url", "allowed_use"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,80}$" },
    "path": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["music_bed", "sfx", "ambience", "footage", "still", "lut", "font", "video", "other"],
      "description": "Use kind:video for moving footage slots. kind:footage is legacy; prefer kind:video + media:video. Stills use kind:still and never fill footage buckets."
    },
    "media": {
      "type": "string",
      "enum": ["video", "still", "audio", "other"]
    },
    "bucket": {
      "type": "string",
      "description": "Niche bucket id e.g. hook_vehicle — see library/footage/buckets/<niche>.json"
    },
    "subject": { "type": "string" },
    "shot_type": {
      "type": "array",
      "items": { "type": "string" }
    },
    "motion": {
      "type": "string",
      "enum": ["none", "low", "medium", "high", "unknown"]
    },
    "motion_confirmed": { "type": "boolean" },
    "must_depict": {
      "type": "array",
      "items": { "type": "string" }
    },
    "depicts_verified": {
      "type": "object",
      "properties": {
        "ok": { "type": "boolean" },
        "labels": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number" },
        "method": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "people": {
      "type": "string",
      "enum": ["none", "hands_only", "face", "group", "unknown"]
    },
    "niche_fit": {
      "type": "string",
      "enum": ["high", "med", "low", "none"]
    },
    "orientation": {
      "type": "string",
      "enum": ["portrait", "landscape", "square", "unknown"]
    },
    "reject": { "type": "boolean" },
    "reject_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "diagram_schematic",
          "illustration",
          "chart_text_heavy",
          "map_signage",
          "logo_trademark",
          "wrong_industry",
          "wrong_era_region",
          "static_no_motion",
          "off_subject",
          "still_in_footage_slot",
          "duplicate",
          "other"
        ]
      }
    },
    "license": { "type": "string" },
    "attribution": { "type": "string", "minLength": 8 },
    "source_url": { "type": "string" },
    "source": { "type": "string" },
    "allowed_use": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "bpm": { "type": ["number", "null"] },
    "mood": { "type": "array", "items": { "type": "string" } },
    "duration_s": { "type": "number" },
    "loop_points_s": {
      "type": "object",
      "properties": { "in": { "type": "number" }, "out": { "type": "number" } }
    },
    "niches": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "phash": { "type": "string" },
    "width": { "type": "number" },
    "height": { "type": "number" },
    "query": { "type": "string" },
    "select_why": { "type": "string" },
    "verified_via": {
      "type": "string",
      "enum": ["human_browser", "agent_runtime", "owned", "user_supplied"]
    }
  }
}
