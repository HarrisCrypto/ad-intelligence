{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HarrisCrypto/ad-intelligence/specs/ad-spec.schema.json",
  "title": "AdSpec",
  "description": "Machine-readable ad package: brief → structure → library bindings → claim ledger. Format/timing honesty is required.",
  "type": "object",
  "required": [
    "id",
    "version",
    "brief",
    "structure",
    "retrieval",
    "library",
    "timeline",
    "claim_ledger",
    "cta",
    "render_status",
    "what_not_to_copy"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,80}$" },
    "version": { "type": "integer", "minimum": 1 },
    "template_id": { "type": "string" },
    "brief": {
      "type": "object",
      "required": ["brand", "niche", "platforms", "offer", "jtbd"],
      "properties": {
        "brand": { "type": "string" },
        "niche": { "type": "string" },
        "platforms": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "offer": { "type": "string" },
        "jtbd": { "type": "string" },
        "url": { "type": "string" },
        "funnel": { "type": "string" },
        "assumptions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "structure": {
      "type": "object",
      "required": ["format", "timing_observable", "duration_s", "aspect"],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "video_timed",
            "search_text",
            "display_static",
            "carousel_static",
            "unknown"
          ]
        },
        "timing_observable": { "type": "boolean" },
        "duration_s": { "type": ["number", "null"] },
        "aspect": { "type": "string" },
        "format_note": { "type": "string" }
      }
    },
    "retrieval": {
      "type": "object",
      "properties": {
        "study_card_ids": { "type": "array", "items": { "type": "string" } },
        "study_id": { "type": "string" },
        "attention_model_id": { "type": "string" },
        "niche_pack": { "type": "string" },
        "gold_fixture": { "type": "string" }
      }
    },
    "library": {
      "type": "object",
      "properties": {
        "ui_kit": { "type": "string" },
        "transition_default": { "type": "string" },
        "grade": { "type": "string" },
        "camera_hook": { "type": "string" },
        "lighting_hook": { "type": "string" },
        "captions": { "type": "object" },
        "typography_provision": { "type": "string" },
        "voice_tier": { "type": "string" }
      }
    },
    "timeline": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "job"],
        "properties": {
          "id": { "type": "string" },
          "t": {
            "type": "array",
            "items": { "type": ["number", "null"] },
            "minItems": 2,
            "maxItems": 2
          },
          "job": { "type": "string" },
          "camera": { "type": "string" },
          "lighting": { "type": "string" },
          "transition_out": { "type": ["string", "null"] },
          "ui_state": { "type": "string" },
          "on_screen_text": { "type": "string" },
          "spoken": { "type": "string" }
        }
      }
    },
    "claim_ledger": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_or_asset", "tag", "source"],
        "properties": {
          "claim_or_asset": { "type": "string" },
          "where": { "type": "string" },
          "tag": {
            "type": "string",
            "enum": ["USER_SUPPLIED", "ASSET_VERIFIED", "PLACEHOLDER", "ASSUMED"]
          },
          "source": { "type": "string" }
        }
      }
    },
    "cta": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": { "type": "string" },
        "on_screen_min_s": { "type": "number" },
        "jargon_ban": { "type": "array", "items": { "type": "string" } },
        "nap_match": { "type": "boolean" }
      }
    },
    "brand_harvest": {
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "status": { "type": "string" },
        "palette_source": { "type": "string" }
      }
    },
    "render_status": {
      "type": "string",
      "enum": ["NOT_RENDERED", "PARTIAL", "RENDERED"]
    },
    "what_not_to_copy": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "qa": {
      "type": "object",
      "properties": {
        "expect_instruments": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "structure": {
            "properties": {
              "format": {
                "enum": ["search_text", "display_static", "carousel_static"]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "structure": {
            "properties": { "timing_observable": { "const": false } }
          }
        }
      }
    }
  ]
}
