{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/ad-intelligence/query.schema.json",
  "title": "AdIntelligenceQuery",
  "type": "object",
  "properties": {
    "platform": {
      "type": "string",
      "enum": [
        "meta",
        "tiktok",
        "youtube",
        "youtube_shorts",
        "google_display",
        "linkedin",
        "snapchat",
        "pinterest",
        "x_twitter",
        "organic_short",
        "ctv_ott",
        "influencer_seed",
        "any"
      ]
    },
    "style": { "type": "string" },
    "funnel_stage": {
      "type": "string",
      "enum": ["tof_awareness", "mof_consideration", "bof_conversion", "retargeting", "any"]
    },
    "niche": { "type": "string" },
    "production_tier": {
      "type": "string",
      "enum": ["native_ugc", "hybrid_polished", "high_production", "premium_cinema", "any"]
    },
    "virality_posture": {
      "type": "string",
      "enum": ["evergreen_dr", "trend_reactive", "share_engineered", "brand_film", "any"]
    },
    "job": {
      "type": "string",
      "description": "What the ad must do, e.g. ride a POV trend, cinematic launch film, save-bait checklist"
    },
    "tag": {
      "type": "string",
      "description": "Shortcut tags: viral, high-production, etc."
    },
    "duration_max": { "type": "number" },
    "limit": { "type": "integer", "minimum": 1, "maximum": 15, "default": 5 }
  }
}
