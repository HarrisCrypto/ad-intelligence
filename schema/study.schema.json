{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/ad-intelligence/study.schema.json",
  "title": "AdStudy",
  "description": "Emulation study with hard provenance + media format. Synthesis is not proof. search_text is not video timing.",
  "type": "object",
  "required": [
    "id",
    "title",
    "platforms",
    "niches",
    "structure",
    "steal",
    "never_copy",
    "why_it_works",
    "human_build",
    "provenance"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "class": {
      "type": "string",
      "enum": ["viral_native", "performance_dr", "award_brand_film", "other"]
    },
    "title": { "type": "string", "minLength": 3 },
    "private": { "type": "boolean" },
    "platforms": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "niches": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "pattern_ids": { "type": "array", "items": { "type": "string" } },
    "attention_model_ids": { "type": "array", "items": { "type": "string" } },
    "when_to_emulate": { "type": "array", "items": { "type": "string" } },
    "when_not": { "type": "array", "items": { "type": "string" } },
    "structure": {
      "type": "object",
      "required": ["format", "timing_observable", "hook_0_3", "beats"],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "video_timed",
            "search_text",
            "display_static",
            "carousel_static",
            "unknown"
          ],
          "description": "Media kind observed/distilled. search_text/display_static must not be treated as 0–3s video."
        },
        "timing_observable": {
          "type": "boolean",
          "description": "false when no video/motion/audio timing was observable"
        },
        "duration_s": { "type": ["number", "null"] },
        "hook_0_3": {
          "type": "string",
          "description": "Open job. For video_timed = 0–3s; for search_text = primary headline — not seconds."
        },
        "beats": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["t", "job"],
            "properties": {
              "t": { "type": "string" },
              "job": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "steal": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "never_copy": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "why_it_works": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "human_build": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step", "action"],
        "properties": {
          "step": { "type": "number" },
          "action": { "type": "string" },
          "tools": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["observed", "basis", "claim_firewall"],
      "properties": {
        "observed": { "type": "boolean" },
        "basis": {
          "type": "string",
          "enum": ["synthesis", "ad-library", "named-campaign", "owned-ad"]
        },
        "claim_firewall": { "type": "string", "minLength": 20 },
        "observed_date": { "type": "string" },
        "library_ids": { "type": "array", "items": { "type": "string" } },
        "observed_limits": {
          "type": "array",
          "items": { "type": "string" },
          "description": "What was NOT observable (e.g. no video, no timing)"
        }
      }
    },
    "research_where": { "type": "object" },
    "source_notes": { "type": "string" },
    "gold_fixture": { "type": "string" },
    "human_build_log": { "type": "string" }
  }
}
