{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/ad-intelligence/study.schema.json",
  "title": "AdStudy",
  "description": "Emulation study with hard provenance. Synthesis is not proof.",
  "type": "object",
  "required": [
    "id",
    "title",
    "platforms",
    "niches",
    "structure",
    "steal",
    "never_copy",
    "why_it_works",
    "human_build",
    "provenance"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "class": {
      "type": "string",
      "enum": ["viral_native", "performance_dr", "award_brand_film", "other"]
    },
    "title": { "type": "string", "minLength": 3 },
    "private": { "type": "boolean" },
    "platforms": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "niches": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "pattern_ids": { "type": "array", "items": { "type": "string" } },
    "attention_model_ids": { "type": "array", "items": { "type": "string" } },
    "when_to_emulate": { "type": "array", "items": { "type": "string" } },
    "when_not": { "type": "array", "items": { "type": "string" } },
    "structure": {
      "type": "object",
      "required": ["hook_0_3", "beats"],
      "properties": {
        "duration_s": { "type": "number" },
        "hook_0_3": { "type": "string" },
        "beats": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["t", "job"],
            "properties": {
              "t": { "type": "string" },
              "job": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "steal": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "never_copy": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "why_it_works": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "human_build": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step", "action"],
        "properties": {
          "step": { "type": "number" },
          "action": { "type": "string" },
          "tools": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["observed", "basis", "claim_firewall"],
      "properties": {
        "observed": {
          "type": "boolean",
          "description": "true only if a human watched a specific ad and filled research_where"
        },
        "basis": {
          "type": "string",
          "enum": ["synthesis", "ad-library", "named-campaign", "owned-ad"]
        },
        "claim_firewall": { "type": "string", "minLength": 20 },
        "observed_date": { "type": "string" },
        "library_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "research_where": { "type": "object" },
    "source_notes": { "type": "string" },
    "gold_fixture": { "type": "string" },
    "human_build_log": {
      "type": "string",
      "description": "Path to a filled human-build log artifact (markdown)"
    }
  }
}
