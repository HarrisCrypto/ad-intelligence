  "studies": [
    {
      "id": "study_viral_confession_ugc",
      "class": "viral_native",
      "title": "Viral confession UGC (TikTok / Reels native)",
      "when_to_emulate": [
        "Cold social, need trust fast",
        "Beauty, health-adjacent lifestyle, consumer apps",
        "Budget favors phone + captions over cinema"
      ],
      "when_not": [
        "Luxury brand-film brief",
        "Regulated disease claims",
        "You only have studio talent that looks fake-UGC"
      ],
      "platforms": ["tiktok", "meta", "instagram", "youtube_shorts"],
      "niches": ["beauty", "health", "ecommerce", "apps", "saas", "fitness"],
      "attention_model_ids": ["am_muted_confession"],
      "pattern_ids": ["ugc-talking-head-scroll-stop"],
      "structure": {
        "duration_s": 21,
        "hook_0_3": "Specific costly mistake in burned text before brand",
        "beats": [
          { "t": "0–1.5s", "job": "confession text + imperfect face", "note": "no logo" },
          { "t": "1.5–6s", "job": "name failure mode", "note": "one mechanism noun" },
          { "t": "6–14s", "job": "demo insert", "note": "product/UI as proof" },
          { "t": "14–18s", "job": "outcome in plain words", "note": "ledger-safe" },
          { "t": "18–21s", "job": "one CTA endcard", "note": "post owns type" }
        ]
      },
      "steal": ["Mid-thought open", "Text density ≤8 words", "Jump cuts on breath", "Brand late"],
      "never_copy": ["Their confession lines", "Fake review counts", "Studio ‘UGC’ polish"],
      "why_it_works": [
        "Native texture beats brand film on cold feed",
        "Specific confession creates ID faster than features"
      ],
      "human_build": [
        { "step": 1, "action": "Write confession hook from customer language (reviews/support), not vibes", "tools": ["brief", "claim-ledger"] },
        { "step": 2, "action": "Shoot or gen talking-head still → short i2v; keep imperfect light", "tools": ["phone", "kling", "flux"] },
        { "step": 3, "action": "Insert product/UI demo unit locked to sheet", "tools": ["screen_record", "generated-ui-authenticity"] },
        { "step": 4, "action": "CapCut: captions, jump cuts, one CTA endcard, loudness", "tools": ["capcut"] },
        { "step": 5, "action": "Export 9:16 (+1:1 if paid Meta); re-lint package with job ids", "tools": ["lint-package"] }
      ],
      "research_where": {
        "libraries": ["tiktok_creative_center", "meta_ad_library"],
        "search_hints": ["UGC talking head", "confession skincare", "I wasted money on"],
        "what_to_note": "Seconds until product appears; caption word count 0–3s"
      },
      "source_notes": "Archetypal feed structure. Not a scrape."
    },
