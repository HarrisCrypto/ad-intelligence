{
  "id": "swipe-signals",
  "version": "1.3.0",
  "updated": "2026-10-10",
  "purpose": "Anonymized longevity signals — formats and hook families that tend to survive, plus common failure modes. No scraped creatives or brand names.",
  "how_agents_use": "After niche+pattern retrieval, optionally read matching niche/format signals. Prefer high-longevity hook families when user wants evergreen performance. Feed fails_when into Self-critique. Never invent CTR/ROAS numbers.",
  "docs": "swipe-signals.md",
  "private_overlay": {
    "file": "private-signals.json",
    "example": "private-signals.example.json",
    "env": "AD_INTEL_PRIVATE_SIGNALS",
    "merge": "Private niche hints prepend; private formats append; never overwrite public ids silently in docs"
  },
  "longevity_tiers": {
    "high": "Often reusable for months with light refreshes",
    "medium": "Works in bursts; refresh hooks weekly",
    "low": "Trend-tied; expire fast"
  },
