{
  "id": "street-interview",
  "name": "Street interview / man-on-the-street",
  "platforms": [
    "tiktok",
    "meta",
    "youtube_shorts",
    "organic_short",
    "youtube"
  ],
  "style": "street_interview",
  "funnel_stage": "tof_awareness",
  "niches": [
    "food_bev",
    "apps",
    "fintech",
    "fashion",
    "health",
    "entertainment",
    "ecommerce"
  ],
  "production_tier": "hybrid_polished",
  "virality_posture": "share_engineered",
  "duration_seconds": {
    "min": 20,
    "max": 75,
    "ideal": 40
  },
  "aspect_ratios": [
    "9:16"
  ],
  "hook": {
    "window_seconds": "0-3",
    "visual": "Host with mic; city energy",
    "audio_or_vo": "How much would you pay for [outcome]?",
    "text_overlay": "We asked strangers…",
    "pattern_interrupt": "Public social tension"
  },
  "body": {
    "beats": [
      {
        "t": "3-25s",
        "purpose": "Funny/wrong answers montage",
        "visual": "Quick cuts of reactions",
        "vo_or_copy": "Keep best soundbites"
      },
      {
        "t": "25-35s",
        "purpose": "Reveal product + price contrast",
        "visual": "Hand product / show phone UI",
        "vo_or_copy": "It’s actually [offer]"
      },
      {
        "t": "35-40s",
        "purpose": "CTA",
        "visual": "QR or handle",
        "vo_or_copy": "Try it / link below"
      }
    ]
  },
  "cta": {
    "type": "learn_more",
    "on_screen": "Try it free",
    "spoken_or_caption": "Link in description",
    "landing_promise": "Same offer named on street"
  },
  "audio_design": {
    "music_energy": "Match platform native expectations",
    "vo_pace": "Clear; pause after hook",
    "captions": "Muted-first, large, high contrast"
  },
  "visual_system": {
    "camera": "Platform-native",
    "lighting": "Honest to the tier",
    "color": "Consistent within the cut",
    "editing_pace": "Match style",
    "text_style": "Readable on mobile"
  },
  "why_it_works": [
    "Curiosity + social proof hybrid",
    "Comment debates",
    "Replays for best answers"
  ],
  "anti_patterns": [
    "Clearly staged answers only",
    "Embarrassing people cruelly"
  ],
  "metrics_signals": [
    "Completion",
    "Shares/saves",
    "Qualified CTR — never invent numbers"
  ],
  "prompt_seeds": {},
  "output_contract": {
    "deliverables": [
      "script",
      "shot_list",
      "caption_track",
      "primary_text",
      "cta_variants",
      "ab_test_matrix"
    ]
  },
  "source_notes": "Pattern distilled from common high-performing structures — no scraped creative."
}
