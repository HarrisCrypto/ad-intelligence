{
  "id": "duet-stitch-react",
  "name": "Duet / Stitch reaction ad",
  "platforms": [
    "tiktok",
    "organic_short",
    "meta"
  ],
  "style": "duet_stitch_react",
  "funnel_stage": "tof_awareness",
  "niches": [
    "beauty",
    "fashion",
    "fitness",
    "food_bev",
    "ecommerce",
    "saas",
    "fintech",
    "gaming",
    "education",
    "travel",
    "real_estate",
    "health",
    "pets",
    "home",
    "apps",
    "b2b_services",
    "creator",
    "entertainment",
    "luxury",
    "automotive",
    "nonprofit",
    "kids"
  ],
  "production_tier": "native_ugc",
  "virality_posture": "trend_reactive",
  "duration_seconds": {
    "min": 8,
    "max": 30,
    "ideal": 18
  },
  "aspect_ratios": [
    "9:16"
  ],
  "hook": {
    "window_seconds": "0-2",
    "visual": "Split layout with source clip OR green-screen of viral claim",
    "audio_or_vo": "Wait — that’s not how [domain] works…",
    "text_overlay": "Reacting to this…",
    "pattern_interrupt": "Borrowed attention from a known clip/claim"
  },
  "body": {
    "beats": [
      {
        "t": "2-10s",
        "purpose": "Correct or escalate",
        "visual": "Creator face + cutaways proving the point",
        "vo_or_copy": "One sharp correction or funnier escalation"
      },
      {
        "t": "10-18s",
        "purpose": "Bridge to offer",
        "visual": "Product/demo insert",
        "vo_or_copy": "Here’s what actually works"
      }
    ]
  },
  "cta": {
    "type": "learn_more",
    "on_screen": "Full breakdown ↓",
    "spoken_or_caption": "I made a simpler version — link",
    "landing_promise": "Article/demo that continues the correction"
  },
  "audio_design": {
    "music_energy": "Match platform native expectations",
    "vo_pace": "Clear; pause after hook",
    "captions": "Muted-first, large, high contrast"
  },
  "visual_system": {
    "camera": "Platform-native",
    "lighting": "Honest to the tier",
    "color": "Consistent within the cut",
    "editing_pace": "Match style",
    "text_style": "Readable on mobile"
  },
  "why_it_works": [
    "Hijacks existing distribution",
    "Argument/reaction formats drive comments",
    "Positions brand as the smarter take"
  ],
  "anti_patterns": [
    "Mean-spirited pile-ons that hurt brand",
    "Reacting without a product truth"
  ],
  "metrics_signals": [
    "Completion",
    "Shares/saves",
    "Qualified CTR — never invent numbers"
  ],
  "prompt_seeds": {
    "script": "18s stitch/react. Open on disagreement. One proof beat. Soft product bridge."
  },
  "output_contract": {
    "deliverables": [
      "script",
      "shot_list",
      "caption_track",
      "primary_text",
      "cta_variants",
      "ab_test_matrix"
    ]
  },
  "source_notes": "Pattern distilled from common high-performing structures — no scraped creative."
}
