  "platforms": [
    "tiktok",
    "linkedin",
    "meta",
    "youtube_shorts",
    "x_twitter",
    "organic_short"
  ],
  "style": "hot_take_controversy",
  "funnel_stage": "tof_awareness",
  "niches": [
    "saas",
    "fintech",
    "education",
    "fitness",
    "beauty",
    "b2b_services",
    "creator"
  ],
  "production_tier": "native_ugc",
